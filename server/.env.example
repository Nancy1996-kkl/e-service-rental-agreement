# Idha copy panni ".env" nu pudhu file create pannunga, real values podunga.
# ⚠️ .env file-ah GitHub-la upload pannave koodaadhu.

# development (local) | production (live server)
NODE_ENV=development
PORT=5000
# Website address. Local: http://localhost:5173 | Live: https://your-domain.com
CLIENT_URL=http://localhost:5173

# Login token secret — generate panna terminal-la run pannunga:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# varra long text-ah keezha paste pannunga
JWT_SECRET=change_this_to_a_long_random_secret

# Aadhaar file encryption key — 64 hex characters. Generate panna:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Idha maathinaa / tholachitta, already upload aana files open aagaadhu. Safe-ah backup pannunga.
# (Development-la empty-ah vittaa, data/.dev-file-key automatic-ah create aagum)
FILE_ENCRYPTION_KEY=

# ===== Storage =====
# local  = server/data (JSON) + server/storage (files)   ← default
# google = Google Sheet + Google Drive (DEPLOYMENT.md → "Google Sheet setup")
STORAGE=local
# DATA_DIR=data
# FILES_DIR=storage

# Google (STORAGE=google-ku mattum)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# PDF create panna Chrome / Edge path (Windows/Mac-la automatic-ah kandupidikkum — theva-na mattum)
# CHROME_PATH=/usr/bin/chromium
